# Server-side only. Get a key at https://api.esv.org/ (create an API Application).
# NEVER prefix with NEXT_PUBLIC_ and never commit a real value.
ESV_API_KEY=

# Optional: MapLibre vector style URL (public, safe for the browser).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Scripture provider: "bsb" (default; public-domain Berean Standard Bible stub, no key needed)
# or "esv" (Crossway ESV API; requires ESV_API_KEY and enforces all ESV terms).
SCRIPTURE_PROVIDER=bsb
